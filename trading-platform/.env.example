# =============================================================================
# AI Forex & Gold Trading Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://trading_user:trading_pass@localhost:5432/trading_platform
DATABASE_URL_SYNC=postgresql+psycopg2://trading_user:trading_pass@localhost:5432/trading_platform

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=true

# ---- MetaTrader 5 ----
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT=60000

# ---- Trading ----
TRADING_MODE=paper
DEFAULT_RISK_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=5.0
MAX_OPEN_POSITIONS=5
MAX_DRAWDOWN_PERCENT=10.0
LIVE_TRADING_ENABLED=false

# ---- Paper Trading ----
PAPER_TRADING_INITIAL_BALANCE=10000.0
PAPER_TRADING_CURRENCY=USD

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/trading_platform.log

# ---- AI/ML ----
AI_ENABLED=false
PYTORCH_ENABLED=false

# ---- News (optional) ----
NEWS_API_KEY=
NEWS_API_PROVIDER=

# ---- Redis (optional) ----
REDIS_URL=redis://localhost:6379/0
