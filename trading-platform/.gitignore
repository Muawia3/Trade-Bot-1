# =============================================================================
# AI Forex & Gold Trading Platform - .gitignore
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# ---- Virtual Environments ----
venv/
.venv/
env/
.env
ENV/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Testing ----
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---- Node/Frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ---- Logs ----
logs/
*.log

# ---- Database ----
*.db
*.sqlite3
database/backups/*.sql
database/backups/*.dump

# ---- Docker ----
docker-compose.override.yml

# ---- Secrets & Credentials ----
.env
.env.local
.env.production
*.pem
*.key
*.cert

# ---- Trading Data ----
data/
*.csv
*.h5
*.hdf5
models/*.pkl
models/*.h5
models/*.pt
models/*.pth

# ---- Alembic ----
backend/migrations/versions/*.pyc

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb

# ---- MyPy ----
.mypy_cache/
.dmypy.json
dmypy.json

# ---- Ruff ----
.ruff_cache/
